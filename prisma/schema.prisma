generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  password      String?
  role          String       @default("USER")
  image         String?
  invitations   Invitation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Template {
  id          String       @id @default(cuid())
  eventType   String       // e.g., "Boda", "XV Años", "Bautizo"
  name        String
  description String?
  thumbnail   String?
  defaultData String       // JSON stringified configuration
  isPremium   Boolean      @default(false)
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Invitation {
  id         String   @id @default(cuid())
  slug       String   @unique // Public URL identifier
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  guestPasses GuestPass[]
  
  // Data for the invitation (photos, texts, config for sections)
  data       String   // JSON stringified data
  
  isPublished Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps       Rsvp[]

  @@index([userId])
}

model GuestPass {
  id           String     @id @default(cuid())
  name         String
  passCount    Int        @default(1)
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([invitationId])
}

model Rsvp {
  id           String     @id @default(cuid())
  name         String
  status       String     // e.g., "CONFIRMED", "DECLINED"
  companions   Int        @default(0)
  contactInfo  String?
  invitationId String
  guestPassId  String?    @unique
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([invitationId])
}

// ================= FINANZAS APP MODELS =================

model FinanzasState {
  id              String   @id @default("default")
  sueldoMensual   Float    @default(20000)
  ahorroMeta      Float    @default(2000)
  gustosMeta      Float    @default(1500)
  imprevistosMeta Float    @default(1050)
  updatedAt       DateTime @updatedAt
}

model FinanzasDebt {
  id        String  @id
  nombre    String
  acreedor  String
  inicial   Float
  mensual   Float
  dia       Int
  quincena  String
  restante  Float
  fin       String
  color     String
}

model FinanzasFixedExpense {
  id        String  @id
  concepto  String
  categoria String
  monto     Float
  dia       Int
  quincena  String
  pagado    Boolean @default(false)
}

model FinanzasTransaction {
  id        String  @id
  fecha     String
  semanaNum Int
  concepto  String
  categoria String
  metodo    String
  monto     Float
  tipo      String
  paidKey   String?
  debtId    String?
  cmovId    String?
  cajitaId  String?
}

model FinanzasCajita {
  id            String  @id
  nombre        String
  tipoCajita    String
  asignado      String
  color         String
  icono         String
  meta          Float   @default(0)
  limiteCredito Float   @default(0)
  diaCorte      Int     @default(1)
  diaPago       Int     @default(15)
  descripcion   String?
  creadaEn      String
}

model FinanzasCajitaMovement {
  id        String  @id
  cajitaId  String
  txId      String?
  tipo      String
  monto     Float
  concepto  String
  fecha     String
  creadoEn  String
}

model FinanzasPaidItem {
  key       String  @id
  value     Boolean @default(true)
}
